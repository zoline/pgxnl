# ── LLM ──────────────────────────────────────────────
# llm_provider: anthropic | openai(vLLM/Ollama 등 OpenAI 호환) | watsonx
PGXNL_LLM_PROVIDER=anthropic
PGXNL_LLM_MODEL=claude-sonnet-4-20250514
PGXNL_LLM_BASE_URL=
PGXNL_LLM_TEMPERATURE=0.0
PGXNL_LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
# llm_provider=openai(vLLM 등)일 때. vLLM 은 키를 안 보지만 비워 두지 않는다
OPENAI_API_KEY=

# llm_provider=watsonx일 때만 사용. LLM_BASE_URL을 watsonx 엔드포인트로 재사용한다
# (예: https://us-south.ml.cloud.ibm.com, 또는 Cloud Pak for Data 설치본 URL).
# project_id/space_id 중 하나는 필수.
# WATSONX_USERNAME이 설정되어 있으면 Cloud Pak for Data(사설/온프렘) 인증을 쓰고,
# 비워두면 IBM Cloud SaaS 공개 IAM 인증을 쓴다. CPD는 API Key 또는 비밀번호 중
# 하나만 있으면 된다(API Key 우선).
WATSONX_API_KEY=
PGXNL_WATSONX_PROJECT_ID=
PGXNL_WATSONX_SPACE_ID=
PGXNL_WATSONX_API_VERSION=2024-05-01
PGXNL_WATSONX_USERNAME=
WATSONX_PASSWORD=

# ── Schema RAG / Embedding ──────────────────────────
# 임베딩 모델(연결·모델·키)은 여기서 정하지 않는다 — 첫 로그인 뒤 관리 화면 → 모델 설정 → 임베딩.
# 대상 DB 를 등록하기 전에 설정해야 등록할 때 스키마 벡터가 만들어진다. 아래는 링킹 튜닝 값이다.
PGXNL_SCHEMA_VECTOR_ENABLED=true
PGXNL_SCHEMA_VECTOR_TOP_K=10
# top_k는 상한일 뿐이라 하위권 후보가 질문과 무관해도 그대로 채워지는 문제가 있었음.
# 1위 후보 점수 대비 이 마진 이내인 것만 남긴다. 0으로 두면 기존처럼 top_k 그대로 사용.
# 임베딩 모델의 점수 스케일에 종속적이라 모델을 바꾸면 재검증 필요(§5.4 참고).
PGXNL_SCHEMA_VECTOR_SCORE_MARGIN=0.10
# 테이블이 이 수 이하인 스키마는 링킹 없이 전부 넣는다.
PGXNL_SCHEMA_VECTOR_KEEP_ALL_MAX_TABLES=3

# ── LLM 테이블 선택 ──────────────────────────────────
# 임베딩 후보(1위 대비 아래 마진 이내)에서 LLM이 필요한 테이블·조인만 다시 고른다.
# 질문당 LLM 호출 1회 추가. BIRD 평가 기준 설정은 true.
PGXNL_TABLE_SELECT_ENABLED=true
PGXNL_TABLE_SELECT_CANDIDATE_MARGIN=0.15

# ── 질문 보강 (기본 비활성) ──────────────────────────
PGXNL_ENRICHMENT_ENABLED=false
# 패턴으로 못 잡는 모호성을 LLM으로 2차 판단 (질문당 LLM 호출 1회 추가, 기본 비활성)
PGXNL_ENRICHMENT_SEMANTIC_CHECK_ENABLED=false

# ── SQL Canonicalization / 검증 ─────────────────────
PGXNL_CANONICALIZATION_ENABLED=true
PGXNL_VALIDATION_MAX_COST=100000
PGXNL_AUDIT_LOG_ENABLED=true

# ── 문서 지식 레이어 (기본 비활성) ───────────────────
PGXNL_DOCUMENT_STORE_ENABLED=false
PGXNL_DOCUMENT_CHUNK_SIZE=500
PGXNL_DOCUMENT_TOP_K=3

# ── 실행이력 기반 FK 발견 (기본 비활성) ──────────────
PGXNL_JOIN_DISCOVERY_ENABLED=false
PGXNL_JOIN_DISCOVERY_SCHEDULE="0 3 * * *"

# ── Agent ────────────────────────────────────────────
PGXNL_AGENT_MAX_ITERATIONS=20
PGXNL_AGENT_MAX_CORRECTIONS=3
PGXNL_AGENT_SAMPLE_ROWS=50
PGXNL_AGENT_STATS_TOP_N=20
PGXNL_AGENT_MAX_CONTEXT_TABLES=15

# ── 캐시 ─────────────────────────────────────────────
PGXNL_SCHEMA_CACHE_TTL=86400
PGXNL_CACHE_ENABLED=true
PGXNL_CACHE_SIMILARITY_THRESHOLD=0.85
PGXNL_CACHE_EMBEDDING_ENABLED=false
PGXNL_CACHE_EMBEDDING_THRESHOLD=0.90
PGXNL_CACHE_TTL_SECONDS=86400

# ── 시스템 DB ────────────────────────────────────────
PGXNL_SYSTEM_PG_DSN=postgresql://pgxnl:pgxnl@localhost:5432/pgxnl
PGXNL_PG_POOL_SIZE=10
PGXNL_PG_MAX_OVERFLOW=20

# ── API 서버 ─────────────────────────────────────────
PGXNL_API_HOST=0.0.0.0
PGXNL_API_PORT=8100
PGXNL_API_WORKERS=4
PGXNL_LOG_LEVEL=info
PGXNL_SECRET_KEY=CHANGE_ME_32_BYTE_KEY
# 관리자 계정(username: pgxnl)의 첫 비밀번호. 첫 기동 때 계정을 만들 때만 쓰인다.
PGXNL_ADMIN_INITIAL_PASSWORD=passw0rd
