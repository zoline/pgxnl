[
 {
  "id": 4,
  "target_name": "BIRD",
  "schema_name": null,
  "rule_type": "generation_constraint",
  "definition": {
   "text": "나눗셈(/) 연산 시 분자는 CAST(컬럼 AS REAL), 분모는 NULLIF(컬럼, 0)으로 감싸세요. 예) col1 / col2 → CAST(col1 AS REAL) / NULLIF(col2, 0). 질문이 100을 곱해야 할 때만, 곱셈을 나눗셈보다 먼저 쓰세요(CAST(col1 AS REAL) * 100 / NULLIF(col2, 0)). 이렇게 하면 분모가 0이거나 NULL일 때 오류 대신 NULL을 반환합니다."
  },
  "enabled": true
 },
 {
  "id": 6,
  "target_name": "BIRD",
  "schema_name": null,
  "rule_type": "generation_constraint",
  "definition": {
   "text": "단순한 서브쿼리를 불필요하게 CTE(WITH 절)로 감싸지 마세요."
  },
  "enabled": true
 },
 {
  "id": 7,
  "target_name": null,
  "schema_name": null,
  "rule_type": "generation_constraint",
  "definition": {
   "text": "RANK() OVER(...)는 질문이 순위(rank)를 직접 요구하거나 그룹별 상위 N개를 물을 때만 씁니다. 그 밖의 경우(\"가장 높은/낮은\", \"상위 N개\", \"N번째\"처럼 그룹 구분이 없는 질문)에는 ORDER BY + LIMIT으로 답하세요. N번째부터 필요하면 OFFSET을 씁니다. 예) ORDER BY col DESC NULLS LAST LIMIT 2 OFFSET 9"
  },
  "enabled": true
 },
 {
  "id": 11,
  "target_name": "BIRD",
  "schema_name": null,
  "rule_type": "few_shot",
  "definition": {
   "bad_sql": "SELECT T1.code, T1.name, T2.score FROM units AS T1 INNER JOIN metrics AS T2 ON T1.id = T2.unit_id WHERE T1.size > 1000 ORDER BY T2.score DESC NULLS LAST",
   "good_sql": "SELECT T1.code, T2.score FROM units AS T1 INNER JOIN metrics AS T2 ON T1.id = T2.unit_id WHERE T1.size > 1000 ORDER BY T2.score DESC NULLS LAST",
   "question": "List the codes of the units whose size exceeds 1000, sorted by their score.",
   "explanation": "name은 질문에 없는 컬럼 — \"codes\"가 이미 식별 컬럼을 지정했으므로 코드만 반환해야 함. 이 예시의 테이블·컬럼 이름은 형태를 보이기 위한 것이며 실제 스키마와 무관합니다."
  },
  "enabled": true
 },
 {
  "id": 12,
  "target_name": null,
  "schema_name": null,
  "rule_type": "generation_constraint",
  "definition": {
   "text": "컬럼에는 명시적으로 필요한 경우(계산식·집계 함수 결과 등 원래 이름이 없는 값)에만 AS 별칭을 붙이고, 단순 컬럼 참조는 별칭을 붙이지 마세요."
  },
  "enabled": true
 },
 {
  "id": 13,
  "target_name": "BIRD",
  "schema_name": null,
  "rule_type": "generation_constraint",
  "definition": {
   "text": "테이블에는 항상 T1, T2, T3, ... 순서로 별칭을 붙이세요."
  },
  "enabled": true
 },
 {
