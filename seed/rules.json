 },
 {
  "id": 41,
  "target_name": "BIRD",
  "schema_name": "california_schools",
  "rule_type": "canonical_rewrite",
  "definition": {
   "kind": "dedupe_columns",
   "bad_sql": "SELECT COUNT(*) AS count, T1.region, COUNT(*) AS region_count FROM units AS T1 WHERE T1.status = 'Active' GROUP BY T1.region",
   "good_sql": "SELECT T1.region, COUNT(*) FROM units AS T1 WHERE T1.status = 'Active' GROUP BY T1.region",
   "when_regex": "GROUP\\s+BY",
   "explanation": "GROUP BY로 집계할 때 전체 개수와 그룹별 개수는 같은 집계식이다 — 같은 식을 컬럼 두 개로 넣지 말 것. 전체 개수는 그 컬럼의 합, 그룹 수는 행 수로 읽힌다. 이 예시의 테이블·컬럼 이름은 형태를 보이기 위한 것이며 실제 스키마와 무관합니다."
  },
  "enabled": true
 },
